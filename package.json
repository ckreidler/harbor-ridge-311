{
  "name": "harbor-ridge-311",
  "version": "0.1.0",
  "scripts": {
    "postinstall": "npm ci --prefix website --include=dev",
    "build": "tsc && npm run build:site",
    "build:site": "npm run build --prefix website",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cfn-lint": "cdk synth --quiet && cfn-lint --non-zero-exit-code error cdk.out/WebsiteStack.template.json cdk.out/ConnectStack.template.json cdk.out/TouchpointStack.template.json"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1141.0",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-qconnect": "3.1153.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.5.0"
  }
}
