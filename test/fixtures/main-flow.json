{
  "Version": "2019-10-30",
  "StartAction": "enable-flow-logging",
  "Actions": [
    {
      "Identifier": "enable-flow-logging",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": {
        "FlowLoggingBehavior": "Enabled"
      },
      "Transitions": {
        "NextAction": "set-en-voice"
      }
    },
    {
      "Identifier": "set-en-voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "Joanna",
        "TextToSpeechEngine": "Neural"
      },
      "Transitions": {
        "NextAction": "lookup-prompts",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "lookup-prompts"
          }
        ]
      }
    },
    {
      "Identifier": "lookup-prompts",
      "Type": "EvaluateDataTableValues",
      "Parameters": {
        "DataTableId": "table",
        "Queries": [
          {
            "QueryName": "Greeting",
            "Attributes": [
              "Text"
            ],
            "PrimaryValues": [
              {
                "AttributeName": "Prompt",
                "Value": "Greeting"
              },
              {
                "AttributeName": "Channel",
                "Value": "$.Channel"
              }
            ]
          },
          {
            "QueryName": "Goodbye",
            "Attributes": [
              "Text"
            ],
            "PrimaryValues": [
              {
                "AttributeName": "Prompt",
                "Value": "Goodbye"
              },
              {
                "AttributeName": "Channel",
                "Value": "$.Channel"
              }
            ]
          },
          {
            "QueryName": "Question",
            "Attributes": [
              "Text"
            ],
            "PrimaryValues": [
              {
                "AttributeName": "Prompt",
                "Value": "Question"
              },
              {
                "AttributeName": "Channel",
                "Value": "$.Channel"
              }
            ]
          }
        ]
      },
      "Transitions": {
        "NextAction": "play-greeting",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-fallback"
          }
        ]
      }
    },
    {
      "Identifier": "play-greeting",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.DataTables.Greeting.Text"
      },
      "Transitions": {
        "NextAction": "branch-identity",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-fallback"
          }
        ]
      }
    },
    {
      "Identifier": "branch-identity",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Channel"
      },
      "Transitions": {
        "NextAction": "check-caller-phone",
        "Conditions": [
          {
            "NextAction": "set-chat-identity",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "CHAT"
              ]
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "check-caller-phone"
          }
        ]
      }
    },
    {
      "Identifier": "set-chat-identity",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "customerId": "$.ContactId",
          "identitySource": "chat"
        },
        "TargetContact": "Current"
      },
      "Transitions": {
        "NextAction": "create-assistant-session",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "create-assistant-session"
          }
        ]
      }
    },
    {
      "Identifier": "check-caller-phone",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.CustomerEndpoint.Address"
      },
      "Transitions": {
        "NextAction": "create-assistant-session",
        "Conditions": [
          {
            "NextAction": "find-profile-phone",
            "Condition": {
              "Operator": "Exists",
              "Operands": []
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "create-assistant-session"
          }
        ]
      }
    },
    {
      "Identifier": "find-profile-phone",
      "Type": "GetCustomerProfile",
      "Parameters": {
        "ProfileRequestData": {
          "IdentifierName": "_phone",
          "IdentifierValue": "$.CustomerEndpoint.Address"
        },
        "ProfileResponseData": []
      },
      "Transitions": {
        "NextAction": "set-customer-id",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "create-assistant-session"
          },
          {
            "ErrorType": "NoneFoundError",
            "NextAction": "create-profile-phone"
          },
          {
            "ErrorType": "MultipleFoundError",
            "NextAction": "create-assistant-session"
          }
        ]
      }
    },
    {
      "Identifier": "create-profile-phone",
      "Type": "CreateCustomerProfile",
      "Parameters": {
        "ProfileRequestData": {
          "PhoneNumber": "$.CustomerEndpoint.Address",
          "FirstName": "Resident"
        }
      },
      "Transitions": {
        "NextAction": "set-customer-id",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "create-assistant-session"
          }
        ]
      }
    },
    {
      "Identifier": "set-customer-id",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "customerId": "$.Customer.ProfileId",
          "identitySource": "ani"
        },
        "TargetContact": "Current"
      },
      "Transitions": {
        "NextAction": "create-assistant-session",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "create-assistant-session"
          }
        ]
      }
    },
    {
      "Identifier": "create-assistant-session",
      "Type": "CreateWisdomSession",
      "Parameters": {
        "WisdomAssistantArn": "assistant"
      },
      "Transitions": {
        "NextAction": "select-orchestrator",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-goodbye"
          }
        ]
      }
    },
    {
      "Identifier": "select-orchestrator",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "orchestrator",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "sessionArn": "$.Wisdom.SessionArn",
          "customerId": "$.Attributes.customerId"
        }
      },
      "Transitions": {
        "NextAction": "ask-en-question",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "ask-en-question"
          }
        ]
      }
    },
    {
      "Identifier": "ask-en-question",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "$.DataTables.Question.Text",
        "LexV2Bot": {
          "AliasArn": "alias"
        },
        "LexSessionAttributes": {
          "x-amz-lex:q-in-connect:session-arn": "$.Wisdom.SessionArn"
        }
      },
      "Transitions": {
        "NextAction": "check-hours",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "InputTimeLimitExceeded",
            "NextAction": "check-hours"
          },
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "check-tool"
          },
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "check-hours"
          }
        ]
      }
    },
    {
      "Identifier": "check-tool",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Lex.SessionAttributes.Tool"
      },
      "Transitions": {
        "NextAction": "play-goodbye",
        "Conditions": [
          {
            "NextAction": "play-goodbye",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "Complete"
              ]
            }
          },
          {
            "NextAction": "set-escalation",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "Escalate"
              ]
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "check-hours"
          }
        ]
      }
    },
    {
      "Identifier": "set-escalation",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "escalationReason": "$.Lex.SessionAttributes.escalationReason",
          "escalationSummary": "$.Lex.SessionAttributes.escalationSummary",
          "customerIntent": "$.Lex.SessionAttributes.customerIntent",
          "sentiment": "$.Lex.SessionAttributes.sentiment"
        },
        "TargetContact": "Current"
      },
      "Transitions": {
        "NextAction": "check-hours",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "check-hours"
          }
        ]
      }
    },
    {
      "Identifier": "check-hours",
      "Type": "CheckHoursOfOperation",
      "Parameters": {
        "HoursOfOperationId": "hours"
      },
      "Transitions": {
        "NextAction": "set-event-flow",
        "Conditions": [
          {
            "NextAction": "set-event-flow",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "True"
              ]
            }
          },
          {
            "NextAction": "check-ticket-subject",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "False"
              ]
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "check-ticket-subject"
          }
        ]
      }
    },
    {
      "Identifier": "set-event-flow",
      "Type": "UpdateContactEventHooks",
      "Parameters": {
        "EventHooks": {
          "DefaultAgentUI": "escalation-guide"
        }
      },
      "Transitions": {
        "NextAction": "set-working-queue",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-goodbye"
          }
        ]
      }
    },
    {
      "Identifier": "set-working-queue",
      "Type": "UpdateContactTargetQueue",
      "Parameters": {
        "QueueId": "queue"
      },
      "Transitions": {
        "NextAction": "set-customer-queue",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-goodbye"
          }
        ]
      }
    },
    {
      "Identifier": "set-customer-queue",
      "Type": "UpdateContactEventHooks",
      "Parameters": {
        "EventHooks": {
          "CustomerQueue": "queue-flow"
        }
      },
      "Transitions": {
        "NextAction": "transfer-to-queue",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "transfer-to-queue"
          }
        ]
      }
    },
    {
      "Identifier": "transfer-to-queue",
      "Type": "TransferContactToQueue",
      "Parameters": {},
      "Transitions": {
        "NextAction": "play-goodbye",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "QueueAtCapacity",
            "NextAction": "play-goodbye"
          },
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-goodbye"
          }
        ]
      }
    },
    {
      "Identifier": "check-ticket-subject",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Attributes.customerIntent"
      },
      "Transitions": {
        "NextAction": "set-fallback-subject",
        "Conditions": [
          {
            "NextAction": "set-ticket-subject",
            "Condition": {
              "Operator": "Exists",
              "Operands": []
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "set-fallback-subject"
          }
        ]
      }
    },
    {
      "Identifier": "set-ticket-subject",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "ticketSubject": "$.Attributes.customerIntent"
        },
        "TargetContact": "Current"
      },
      "Transitions": {
        "NextAction": "check-customer-id",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "set-fallback-subject"
          }
        ]
      }
    },
    {
      "Identifier": "set-fallback-subject",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "ticketSubject": "After-hours request"
        },
        "TargetContact": "Current"
      },
      "Transitions": {
        "NextAction": "check-customer-id",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "check-customer-id",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Attributes.customerId"
      },
      "Transitions": {
        "NextAction": "play-closed",
        "Conditions": [
          {
            "NextAction": "create-ticket",
            "Condition": {
              "Operator": "Exists",
              "Operands": []
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "create-ticket",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "ticket-lambda",
        "InvocationTimeLimitSeconds": "8"
      },
      "Transitions": {
        "NextAction": "check-ticket-id",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "check-ticket-id",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.External.ticketId"
      },
      "Transitions": {
        "NextAction": "play-closed",
        "Conditions": [
          {
            "NextAction": "lookup-after-hours-ticket",
            "Condition": {
              "Operator": "Exists",
              "Operands": []
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "lookup-after-hours-ticket",
      "Type": "EvaluateDataTableValues",
      "Parameters": {
        "DataTableId": "table",
        "Queries": [
          {
            "QueryName": "AfterHoursTicket",
            "Attributes": [
              "Text",
              "TextAfter"
            ],
            "PrimaryValues": [
              {
                "AttributeName": "Prompt",
                "Value": "AfterHoursTicket"
              },
              {
                "AttributeName": "Channel",
                "Value": "$.Channel"
              }
            ]
          }
        ]
      },
      "Transitions": {
        "NextAction": "check-ticket-prompt",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "check-ticket-prompt",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.DataTables.AfterHoursTicket.Text"
      },
      "Transitions": {
        "NextAction": "play-closed",
        "Conditions": [
          {
            "NextAction": "branch-ticket-channel",
            "Condition": {
              "Operator": "Exists",
              "Operands": []
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "branch-ticket-channel",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Channel"
      },
      "Transitions": {
        "NextAction": "play-ticket-voice",
        "Conditions": [
          {
            "NextAction": "play-ticket-chat",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "CHAT"
              ]
            }
          }
        ],
        "Errors": [
          {
            "ErrorType": "NoMatchingCondition",
            "NextAction": "play-ticket-voice"
          }
        ]
      }
    },
    {
      "Identifier": "play-ticket-chat",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.DataTables.AfterHoursTicket.Text $.External.ticketId. $.DataTables.AfterHoursTicket.TextAfter"
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "play-ticket-voice",
      "Type": "MessageParticipant",
      "Parameters": {
        "SSML": "<speak>$.DataTables.AfterHoursTicket.Text <say-as interpret-as=\"characters\">$.External.ticketId</say-as>. $.DataTables.AfterHoursTicket.TextAfter</speak>"
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "play-closed"
          }
        ]
      }
    },
    {
      "Identifier": "play-closed",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Harbor Ridge 311 is closed right now. Our team is available Monday to Friday, 8 a.m. to 5 p.m. Pacific."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "disconnect"
          }
        ]
      }
    },
    {
      "Identifier": "play-goodbye",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.DataTables.Goodbye.Text"
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "disconnect"
          }
        ]
      }
    },
    {
      "Identifier": "play-fallback",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you for calling Harbor Ridge 3 1 1. This line is a demo. Thank you for calling Harbor Ridge 3 1 1. Goodbye."
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Conditions": [],
        "Errors": [
          {
            "ErrorType": "NoMatchingError",
            "NextAction": "disconnect"
          }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
